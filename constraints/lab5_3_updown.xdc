set_property PACKAGE_PIN B6 [get_ports clk]
set_property PACKAGE_PIN Y1 [get_ports rst]
set_property PACKAGE_PIN K4 [get_ports button]
set_property PACKAGE_PIN L4 [get_ports {count[0]}]
set_property PACKAGE_PIN M4 [get_ports {count[1]}]
set_property PACKAGE_PIN M2 [get_ports {count[2]}]
set_property PACKAGE_PIN N7 [get_ports down]
set_property IOSTANDARD LVCMOS33 [get_ports *]
create_clock -name main_clock -period 20.000 [get_ports clk]
set_false_path -from [get_ports {rst button}]
set_false_path -to [get_ports {count[*] down}]
