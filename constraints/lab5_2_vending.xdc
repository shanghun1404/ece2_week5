set_property PACKAGE_PIN B6 [get_ports clk]
set_property PACKAGE_PIN Y1 [get_ports rst]
set_property PACKAGE_PIN K4 [get_ports a]
set_property PACKAGE_PIN N8 [get_ports b]
set_property PACKAGE_PIN N4 [get_ports c]
set_property PACKAGE_PIN L4 [get_ports {state[0]}]
set_property PACKAGE_PIN M4 [get_ports {state[1]}]
set_property PACKAGE_PIN M2 [get_ports {state[2]}]
set_property PACKAGE_PIN N7 [get_ports y]
set_property PACKAGE_PIN M7 [get_ports vend_pulse]
set_property IOSTANDARD LVCMOS33 [get_ports *]
# 50 MHz target inherited from week4; lecture specifies B6, not frequency.
create_clock -name main_clock -period 20.000 [get_ports clk]
set_false_path -from [get_ports {rst a b c}]
set_false_path -to [get_ports {state[*] y vend_pulse}]
